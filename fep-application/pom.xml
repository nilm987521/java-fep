<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fep</groupId>
        <artifactId>fep-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fep-application</artifactId>
    <packaging>jar</packaging>

    <name>FEP Application</name>
    <description>FEP System - Spring Boot Application Entry Point</description>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- 排除 Tomcat，改用 Undertow -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Undertow 伺服器 (Red Hat, LGPL 2.1 / Apache 2.0 雙授權) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- FEP Internal Modules -->
        <dependency>
            <groupId>com.fep</groupId>
            <artifactId>fep-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fep</groupId>
            <artifactId>fep-message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fep</groupId>
            <artifactId>fep-communication</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fep</groupId>
            <artifactId>fep-transaction</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fep</groupId>
            <artifactId>fep-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fep</groupId>
            <artifactId>fep-settlement</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fep</groupId>
            <artifactId>fep-common-db</artifactId>
        </dependency>

        <!-- Camunda BPM Webapp (Cockpit, Tasklist, Admin) -->
        <dependency>
            <groupId>org.camunda.bpm.springboot</groupId>
            <artifactId>camunda-bpm-spring-boot-starter-webapp</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- H2 Database for Development (dev-h2 profile) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Oracle JDBC Driver (provided - 不打包，由外部提供，避免授權問題) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- API Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- DevTools (optional, for development) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- JAR 輸出目錄 (相對於專案根目錄) -->
        <release.directory>${project.basedir}/../release</release.directory>
    </properties>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin - Creates executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.fep.application.FepApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                        <!-- 排除 Oracle JDBC，由外部 lib 目錄提供 (避免授權問題) -->
                        <exclude>
                            <groupId>com.oracle.database.jdbc</groupId>
                            <artifactId>ojdbc11</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy JAR and config files to release directory after package -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-to-release</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Create release directories -->
                                <mkdir dir="${release.directory}"/>
                                <mkdir dir="${release.directory}/config"/>
                                <mkdir dir="${release.directory}/lib"/>

                                <!-- Create README for external libs -->
                                <echo file="${release.directory}/lib/README.txt"><![CDATA[External Libraries Directory
============================

請將以下 JAR 檔案放置於此目錄：

1. Oracle JDBC Driver (必要，連接 Oracle 資料庫時)
   - 檔案名稱: ojdbc11.jar (或 ojdbc8.jar)
   - 下載來源: 從客戶的 Oracle 安裝目錄取得
              或從 Oracle 官網下載: https://www.oracle.com/database/technologies/appdev/jdbc-downloads.html
   - 版本建議: 23.3.0.23.09 或更新版本

注意事項：
- 這些 JAR 因授權限制，不包含在產品發布包中
- 客戶需自行從 Oracle 取得並放置於此目錄
- 啟動腳本會自動載入此目錄下的所有 JAR 檔案
]]></echo>

                                <!-- Copy executable JAR -->
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      tofile="${release.directory}/${project.artifactId}.jar"
                                      overwrite="true"/>

                                <!-- Copy Spring config files (for external override) -->
                                <copy todir="${release.directory}/config" overwrite="true">
                                    <fileset dir="${project.basedir}/src/main/resources">
                                        <include name="application*.yml"/>
                                        <include name="bpmn.yml"/>
                                    </fileset>
                                </copy>

                                <!-- Copy channel config files -->
                                <copy todir="${release.directory}/config" overwrite="true" failonerror="false">
                                    <fileset dir="${project.basedir}/../config">
                                        <include name="*.json"/>
                                    </fileset>
                                </copy>

                                <!-- Copy BPMN process definition files -->
                                <copy todir="${release.directory}/bpmn" overwrite="true">
                                    <fileset dir="${project.basedir}/src/main/resources/bpmn">
                                        <include name="*.bpmn"/>
                                    </fileset>
                                </copy>

                                <!-- Create startup script (Unix) -->
                                <echo file="${release.directory}/start.sh"><![CDATA[#!/bin/bash
# FEP Application Startup Script
# Usage: ./start.sh [profile]
# Profiles: dev (default), dev-h2, prod

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROFILE="${1:-dev}"
JAR_FILE="$SCRIPT_DIR/fep-application.jar"
CONFIG_DIR="$SCRIPT_DIR/config"
LIB_DIR="$SCRIPT_DIR/lib"

echo "Starting FEP Application..."
echo "Profile: $PROFILE"
echo "Config: $CONFIG_DIR"
echo "External libs: $LIB_DIR"

# loader.path: 載入外部 JAR (Oracle JDBC 等有授權限制的依賴)
java -Dloader.path="$LIB_DIR" \
    -jar "$JAR_FILE" \
    --spring.profiles.active="$PROFILE" \
    --spring.config.additional-location="file:$CONFIG_DIR/" \
    --fep.connection.config-path="$CONFIG_DIR/channel-config.json" \
    --fep.channel.config-file="$CONFIG_DIR/channel-schema-mapping.json"
]]></echo>
                                <chmod file="${release.directory}/start.sh" perm="755"/>

                                <!-- Create startup script (Windows) -->
                                <echo file="${release.directory}/start.bat"><![CDATA[@echo off
REM FEP Application Startup Script
REM Usage: start.bat [profile]
REM Profiles: dev (default), dev-h2, prod

set SCRIPT_DIR=%~dp0
set PROFILE=%1
if "%PROFILE%"=="" set PROFILE=dev
set JAR_FILE=%SCRIPT_DIR%fep-application.jar
set CONFIG_DIR=%SCRIPT_DIR%config
set LIB_DIR=%SCRIPT_DIR%lib

echo Starting FEP Application...
echo Profile: %PROFILE%
echo Config: %CONFIG_DIR%
echo External libs: %LIB_DIR%

REM loader.path: 載入外部 JAR (Oracle JDBC 等有授權限制的依賴)
java -Dloader.path="%LIB_DIR%" ^
    -jar "%JAR_FILE%" ^
    --spring.profiles.active="%PROFILE%" ^
    --spring.config.additional-location="file:%CONFIG_DIR%/" ^
    --fep.connection.config-path="%CONFIG_DIR%/channel-config.json" ^
    --fep.channel.config-file="%CONFIG_DIR%/channel-schema-mapping.json"
]]></echo>

                                <echo message=""/>
                                <echo message="=== Release Package Created ==="/>
                                <echo message="Location: ${release.directory}"/>
                                <echo message=""/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Production profile -->
        <profile>
            <id>prod</id>
            <properties>
                <spring.profiles.active>prod</spring.profiles.active>
            </properties>
        </profile>
    </profiles>
</project>
